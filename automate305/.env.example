# Automate305 prospect feed — copy to automate305/.env and fill in.
# .env is gitignored. Never paste these into the HTML file.

# HubSpot private-app token. Create at:
#   HubSpot → Settings → Integrations → Private Apps → Create private app
# Scopes needed:
#   crm.objects.contacts.read     crm.objects.contacts.write
#   crm.objects.companies.read    crm.objects.companies.write
#   crm.objects.notes.write       crm.schemas.contacts.write
#   crm.schemas.companies.write
# Token looks like: pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_TOKEN=

# Optional. Only needed if you want clay/enrich.mjs to call Clay directly.
# Leave blank to use the MCP path (enrich.mjs --print-batch).
CLAY_API_KEY=

# Optional overrides
# PORT=4305
# DBPR_PROJECT_DIR=/Users/camilog/Desktop/DBPR HVAC Import Script - Cursor
